      "frameId": null,
      "index": "amG",
      "roundness": null,
      "seed": 936615936,
      "version": 1577,
      "versionNonce": 1787453440,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791971560424,
      "created": 1791971368440,
      "link": null,
      "locked": false,
      "text": "H1: app will provoke echo chamber formation\nH2: app will make people avoid fixing relationship issues instead find new people\nH3: app might force people into rolles and disallow broader participation",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H1: app will provoke echo chamber formation\nH2: app will make people avoid fixing relationship issues instead find new people\nH3: app might force people into rolles and disallow broader participation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
