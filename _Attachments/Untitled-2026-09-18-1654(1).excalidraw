    {
      "id": "kmhgYQqO1J63lAqwZTBN9",
      "type": "text",
      "x": 345.5500077527456,
      "y": 721.7930722259925,
      "width": 742.9500122070312,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1188649636,
      "version": 1124,
      "versionNonce": 304766976,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791979503179,
      "created": 1791932741355,
      "link": null,
      "locked": false,
      "text": "H1: if i lead people together like this they will have \"better fitting\" friends\nH2: this app encourages more interactions with strangers\nH3: trust in strangers increases as total app time usage does\nH4: Stereotypes are reduced as total app usage time increases\nH5: People who have not had many social connections will have significantly more\nH6: People will form more specific connections",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H1: if i lead people together like this they will have \"better fitting\" friends\nH2: this app encourages more interactions with strangers\nH3: trust in strangers increases as total app time usage does\nH4: Stereotypes are reduced as total app usage time increases\nH5: People who have not had many social connections will have significantly more\nH6: People will form more specific connections",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hIEm4-YOFzddWAuJKqoLr",
      "type": "text",
      "x": 347.6331921441522,
      "y": 932.500851763998,
      "width": 734.9166870117188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
